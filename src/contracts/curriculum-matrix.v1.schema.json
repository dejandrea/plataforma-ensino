{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Matriz curricular Bitaria v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "course"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "course": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "pattern": "[^\\s]"
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "totalHours": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "modules": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "title": {
                "type": "string",
                "maxLength": 300,
                "pattern": "[^\\s]"
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 20000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "orderIndex": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationMinutes": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "submodules": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "[^\\s]"
                    },
                    "description": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 20000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "orderIndex": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "durationMinutes": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1440
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "lessons": {
                      "type": "array",
                      "maxItems": 1000,
                      "items": {
                        "type": "object",
                        "required": [
                          "title"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                          },
                          "title": {
                            "type": "string",
                            "maxLength": 300,
                            "pattern": "[^\\s]"
                          },
                          "description": {
                            "oneOf": [
                              {
                                "type": "string",
                                "maxLength": 20000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "orderIndex": {
                            "oneOf": [
                              {
                                "type": "integer",
                                "minimum": -1000000,
                                "maximum": 1000000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "durationMinutes": {
                            "oneOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1440
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "curriculumNumber": {
                            "oneOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 999
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "objectives": {
                            "oneOf": [
                              {
                                "type": "array",
                                "maxItems": 100,
                                "uniqueItems": true,
                                "items": {
                                  "type": "string",
                                  "maxLength": 2000,
                                  "pattern": "[^\\s]"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lessonKey": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{0,63}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
