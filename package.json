{
  "name": "plataforma-ensino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:learning": "node --test tests/learning-content.test.mjs tests/learning-foundation.test.mjs tests/student-learning.test.mjs tests/learning-progress.test.mjs tests/interactive-learning.test.mjs tests/interactive-contract.test.mjs tests/teacher-learning.test.mjs tests/official-xp.test.mjs",
    "test:learning:browser": "node --test --test-concurrency=1 tests/learning-browser.test.mjs tests/interactive-browser.test.mjs tests/teacher-learning-browser.test.mjs tests/official-xp-browser.test.mjs tests/student-resource-browser.test.mjs tests/admin-lesson-preview.test.mjs",
    "test:improvements": "node --test tests/improvements.test.mjs tests/lesson-history-status.test.mjs",
    "test:improvements:browser": "node --test --test-concurrency=1 tests/improvements-browser.test.mjs tests/official-xp-browser.test.mjs tests/html-lesson-homologation.test.mjs",
    "test:pdf": "node --experimental-strip-types --test --test-concurrency=1 tests/lesson-report-pdf.test.mjs tests/lesson-report-pdf-browser.test.mjs",
    "test:video": "node --test --test-concurrency=1 tests/video-learning.test.mjs tests/video-learning-browser.test.mjs",
    "test:pedagogy": "node --test --test-concurrency=1 tests/pedagogy.test.mjs tests/pedagogy-browser.test.mjs",
    "test:curriculum": "node --test --test-concurrency=1 tests/curriculum-v2.test.mjs tests/curriculum-v2-browser.test.mjs",
    "test:flashcards": "node --test --test-concurrency=1 tests/flashcards.test.mjs tests/flashcards-browser.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/postcss": "^4.2.1",
    "ajv": "6.14.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
