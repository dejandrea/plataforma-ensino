        "activityKey": "encontro-pratico",
        "content": {
          "schemaVersion": 1,
          "objectives": [
            "Construir uma página e explicar sua estrutura"
          ],
          "prerequisites": [
            "Reconhecer arquivos e pastas"
          ],
          "preparation": [
            "Conferir editor e navegador",
            "Abrir o exemplo localmente"
          ],
          "durationMinutes": 45,
          "steps": [
            {
              "key": "criar-documento",
              "title": "Criar o primeiro documento",
              "objective": "Separar metadados e conteúdo visível.",
              "durationMinutes": 25,
              "guidance": "Peça ao aluno para digitar, salvar e abrir o arquivo no navegador.",
              "code": {
                "language": "html",
                "file": "index.html",
                "source": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Minha página</title>\n</head>\n<body>\n  <h1>Olá, mundo!</h1>\n  <p>Estou aprendendo HTML.</p>\n</body>\n</html>",
                "expectedResult": "Uma página com título e parágrafo; o nome aparece na aba."
              },
              "questions": [
                {
                  "prompt": "Onde aparece o conteúdo de title?",
                  "expectedAnswer": "Na aba do navegador."
                }
              ],
              "detailedExplanation": "O navegador interpreta os elementos e organiza a página. HTML descreve a estrutura.",
              "playfulExplanation": "O head é a etiqueta da mochila; o body guarda o que mostramos na apresentação.",
              "commonDifficulties": [
                "Salvar como .txt",
                "Esquecer uma tag de fechamento"
              ],
              "challenge": "Adicione um segundo parágrafo."
            },
            {
              "key": "revisar-semantica",
              "title": "Revisar e explicar",
              "objective": "Verificar a compreensão.",
              "durationMinutes": 20,
              "guidance": "Peça que explique cada elemento e revise as alterações.",
              "questions": [
                {
                  "prompt": "Por que usar h1?",
                  "expectedAnswer": "Para identificar o título principal do conteúdo."
                }
              ],
              "detailedExplanation": "Os títulos expressam a hierarquia do conteúdo.",
              "playfulExplanation": "O h1 é o nome na capa do livro.",
              "commonDifficulties": [
                "Confundir title e h1"
              ],
              "challenge": "Explique a diferença entre o título da aba e o título da página."
            }
          ],
          "assessmentCriteria": [
            "Explica head e body",
            "Altera o arquivo com autonomia"
          ]
        }
      }
    ]
