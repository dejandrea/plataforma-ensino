{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "type": {
      "const": "flashcards"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "front": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "image": {
                "type": "object",
                "properties": {
                  "resourceUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^https://[a-zA-Z0-9.-]+(:443)?(/[^\\s]*)?$"
                  },
                  "altText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "resourceUrl",
                  "altText"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title",
              "question"
            ],
            "additionalProperties": false
          },
          "back": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "curiosity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "image": {
                "type": "object",
                "properties": {
                  "resourceUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^https://[a-zA-Z0-9.-]+(:443)?(/[^\\s]*)?$"
                  },
                  "altText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "resourceUrl",
                  "altText"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "summary",
              "explanation",
              "impact"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "front",
          "back"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "cards"
  ],
  "additionalProperties": false
}
